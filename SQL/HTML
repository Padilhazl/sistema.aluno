<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Loja Virtual</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #f4f4f4; }
        .grid { display: flex; gap: 20px; }
        .card { background: #fff; padding: 15px; border-radius: 8px; width: 200px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .preco { color: #2e7d32; font-weight: bold; font-size: 1.2em; }
        .em-estoque { color: #1b5e20; font-size: 0.9em; }
        .sem-estoque { color: #c62828; font-size: 0.9em; font-weight: bold; }
        button { background: #007bff; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-top: 10px; }
        button:disabled { background: #ccc; cursor: not-allowed; }
    </style>
</head>
<body>
    <h2>Produtos em Destaque</h2>
    <div class="grid">
        <div class="card">
            <h3>Camiseta Básica</h3>
            <p class="preco">R$ 49,90</p>
            <p class="em-estoque">Em estoque: 15 un.</p>
            <button>Comprar</button>
        </div>
        <div class="card">
            <h3>Mochila Escolar</h3>
            <p class="preco">R$ 89,90</p>
            <p class="sem-estoque">Esgotado</p>
            <button disabled>Indisponível</button>
        </div>
    </div>
</body>
</html>